<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netcoreapp2.2</TargetFramework>
    <OutputType>Library</OutputType>
    <PackageId>Lmc.Kafka</PackageId>
    <Version>5.2.0</Version>
    <RepositoryUrl>https://stash.int.lmc.cz/projects/ARCHI/repos/fkafka/browse</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/Types.fs" />
    <Compile Include="src/Admin.fs" />
    <Compile Include="src/Checker.fs" />
    <Compile Include="src/Consumer.fs" />
    <Compile Include="src/Events.fs" />
    <Compile Include="src/Producer.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../fmetrics/Metrics.fsproj">
      <Name>Metrics.fsproj</Name>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="1.0.0-RC6" />
    <PackageReference Include="FSharp.Data" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lmc.ServiceIdentification" Version="2.0" />
  </ItemGroup>

</Project>

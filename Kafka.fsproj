<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Library</OutputType>
    <PackageId>Lmc.Kafka</PackageId>
    <Version>20.5.0</Version>
    <RepositoryUrl>https://bitbucket.lmc.cz/projects/ARCHI/repos/fkafka/browse</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/Types.fs" />
    <Compile Include="src/Admin.fs" />
    <Compile Include="src/Checker.fs" />
    <Compile Include="src/Trace.fs" />
    <Compile Include="src/Consumer.fs" />
    <Compile Include="src/Events.fs" />
    <Compile Include="src/Producer.fs" />
    <Compile Include="src/MetaData.fs" />
  </ItemGroup>

  <Import Project=".paket\Paket.Restore.targets" />
</Project>

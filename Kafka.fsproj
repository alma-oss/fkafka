<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <PackageId>Alma.Kafka</PackageId>
    <Version>28.1.0</Version>
    <Authors>Almacareer</Authors>
    <Description>Library for reading messages or producing messages to/from stream.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/alma-oss/fkafka.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/alma-oss/fkafka</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/Types.fs" />
    <Compile Include="src/Admin.fs" />
    <Compile Include="src/Checker.fs" />
    <Compile Include="src/Trace.fs" />
    <Compile Include="src/Consumer.fs" />
    <Compile Include="src/Events.fs" />
    <Compile Include="src/Producer.fs" />
    <Compile Include="src/MetaData.fs" />
  </ItemGroup>

  <Import Project=".paket\Paket.Restore.targets" />
</Project>

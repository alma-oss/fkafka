<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <OutputType>Library</OutputType>
    <PackageId>Alma.Kafka</PackageId>
    <Version>24.0.0</Version>
    <RepositoryUrl>https://github.com/almacareer/prc-fkafka</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/Types.fs" />
    <Compile Include="src/Admin.fs" />
    <Compile Include="src/Checker.fs" />
    <Compile Include="src/Trace.fs" />
    <Compile Include="src/Consumer.fs" />
    <Compile Include="src/Events.fs" />
    <Compile Include="src/Producer.fs" />
    <Compile Include="src/MetaData.fs" />
  </ItemGroup>

  <Import Project=".paket\Paket.Restore.targets" />
</Project>

framework: net7.0

source https://api.nuget.org/v3/index.json
nuget FSharp.Core ~> 7.0
nuget FSharp.Data ~> 6.0
# There is no issue for it, but since version 2.1.0, first 1 (or 2) consumed messages are not connected correctly.
# After those, everything works fine.
#
# Error:
# Confluent.Kafka.ConsumeException: Subscribed topic not available: {topic}: Broker: Unknown topic or partition
#   at Confluent.Kafka.Consumer`2.Consume(Int32 millisecondsTimeout)
#   at Confluent.Kafka.Consumer`2.Consume(CancellationToken cancellationToken)
#   at Lmc.Kafka.Consumer.Consume.consume(Consumer consumer) in /Users/petr.chromec/fsharp/fkafka/src/Consumer.fs:line 332
#
nuget Confluent.Kafka 2.0.2
nuget librdkafka.redist 2.0.2
nuget FSharp.Control.AsyncSeq ~> 3.1
nuget Microsoft.Extensions.Logging ~> 7.0

git ssh://git@bitbucket.lmc.cz:7999/archi/nuget-server.git master Packages: /nuget/
# LMC Nuget dependencies:
nuget Lmc.ErrorHandling ~> 7.0
nuget Lmc.Metrics ~> 7.0
nuget Lmc.Serializer ~> 4.1
nuget Lmc.ServiceIdentification ~> 7.0
nuget Lmc.State ~> 6.0
nuget Lmc.Tracing ~> 7.0

nuget Expecto
nuget YoloDev.Expecto.TestSdk

// [ FAKE GROUP ]
group Build
    storage none
    source https://api.nuget.org/v3/index.json
    nuget Fake.DotNet.Cli
    nuget Fake.IO.FileSystem
    nuget Fake.IO.Zip
    nuget Fake.Core.Target
    nuget Fake.Core.UserInput
    nuget Fake.DotNet.AssemblyInfoFile
    nuget Fake.Core.ReleaseNotes
    nuget Fake.Tools.Git
